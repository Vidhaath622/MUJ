# Copy to backend/.env for local dev. Never commit the real .env.

# HS256 signing key. Leave empty to auto-generate one into data/.jwt_secret.
JWT_SECRET=
# Directory that contains the engine/ package (the repo root once branches merge).
RAGSEAL_ENGINE_PATH=/path/to/MUJ-engine
# Extra CORS origins, comma-separated (localhost:5173 is always allowed).
CORS_ORIGINS=

# Model providers. Each role is auto | ollama | groq | nvidia.
# auto: generator and embeddings use local Ollama; the judge uses Groq, then NVIDIA, then Ollama.
GROQ_API_KEY=
NVIDIA_API_KEY=
RAGSEAL_GENERATOR_PROVIDER=auto
RAGSEAL_JUDGE_PROVIDER=auto
RAGSEAL_EMBED_PROVIDER=auto
OLLAMA_HOST_URL=http://localhost:11434
# Model overrides (defaults in engine/config.py MODEL_DEFAULTS), for example:
# RAGSEAL_GROQ_MODEL=openai/gpt-oss-120b
# NVIDIA_JUDGE_MODEL=mistralai/mistral-large-2-instruct
