# RAGSeal Environment Configuration Template
# Copy this file to .env and supply your credentials

# ==============================================================================
# 1. NVIDIA NIM (Primary Hosted Evaluation & Target Generation APIs)
# Catalog: https://build.nvidia.com/models?filters=nimType%3Anim_type_preview%2CnimType%3Anim_type_run_anywhere%2CnimType%3Anim_type_upgrade_available&page=1&orderBy=weightPopular%3ADESC
# Get your API key at: https://build.nvidia.com/settings/api-keys
# ==============================================================================
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Models on NVIDIA NIM
NVIDIA_JUDGE_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_GENERATOR_MODEL=meta/llama-3.2-3b-instruct
NVIDIA_REASONING_MODEL=deepseek-ai/deepseek-r1
NVIDIA_SYNTHETIC_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# ==============================================================================
# 2. Local Fallback Providers (Optional)
# ==============================================================================
OLLAMA_BASE_URL=http://localhost:11434
GROQ_API_KEY=

# ==============================================================================
# 3. Backend & App Settings
# ==============================================================================
PORT=8000
ENVIRONMENT=development
JWT_SECRET=
